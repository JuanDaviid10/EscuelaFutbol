public class Main {
    public static void main(String[] args) {
        System.out.println("=== ARCHIVO HISTORICO DEPARTAMENTAL - PLAN DE DIGITALIZACION ===\n");

        // ---------- 1. Ficha modelo de serie + clonacion (Prototype) ----------
        ProductorDocumental notaria3 = new ProductorDocumental(
            "Notaria 3 de la ciudad", Arrays.asList("Notario titular", "Secretario"));

        FichaCatalografica fichaModelo = new FichaCatalografica(
            "NOTARIAL", notaria3, "Protocolos de escrituras publicas",
            "Acceso restringido - requiere autorizacion", "Espanol",
            Arrays.asList("Notariado", "Propiedad raiz", "Siglo XIX"));

        FondoNotarial fondoNotarial = new FondoNotarial();
        List<FichaCatalografica> fichasSerie = new ArrayList<>();
        List<ItemDocumental> itemsNotarial = new ArrayList<>();

        String[] titulos = {"Escritura 112 de 1887", "Escritura 118 de 1887", "Escritura 121 de 1887",
                             "Escritura 130 de 1887", "Escritura 145 de 1887"};
        int[] folios = {8, 12, 6, 9, 11};

        for (int i = 0; i < 5; i++) {
            FichaCatalografica ficha = fichaModelo.clonar();
            ficha.titulo = titulos[i];
            ficha.fechaExtrema = "1887";
            ficha.folios = folios[i];
            fichasSerie.add(ficha);

            ItemDocumental item = new ItemDocumental(ficha.titulo, 1887, ficha.folios);
            item.notaria = 3;
            fondoNotarial.registrar(item);
            itemsNotarial.add(item);
        }

        // personalizar UN item sin afectar la ficha modelo ni los demas
        fichasSerie.get(1).agregarDescriptor("Litigio de tierras");
        fichasSerie.get(1).agregarCargoProductor("Testigo instrumental");

        System.out.println("Ficha modelo: '" + fichaModelo.alcance + "' | descriptores: "
            + fichaModelo.descriptores.size() + " | cargos productor: " + fichaModelo.productor.cargos.size());
        for (int i = 0; i < itemsNotarial.size(); i++) {
            System.out.println("  " + itemsNotarial.get(i).signatura + "  " + fichasSerie.get(i).titulo
                + "  folios " + fichasSerie.get(i).folios
                + (i == 1 ? "  <- descriptor agregado" : ""));
        }
        System.out.println("  Verificacion ficha modelo -> descriptores: " + fichaModelo.descriptores.size()
            + " | cargos: " + fichaModelo.productor.cargos.size() + "  (intacta)");

        // ---------- 2. Registro en los tres fondos (Factory Method) ----------
        System.out.println("\nSIGNATURAS POR FONDO (consecutivos independientes)");

        FondoCartografico fondoCartografico = new FondoCartografico();
        FabricaSoporte fabricaMicrofilm = new FabricaMicrofilm();

        ItemDocumental mapa1 = new ItemDocumental("Plano urbano 1925", 1925, 1);
        mapa1.escala = "25000";
        fondoCartografico.registrar(mapa1);
        mapa1.setMetadato("titulo", "Plano urbano 1925");
        mapa1.setMetadato("fecha", "1925");
        // a proposito NO se cargan "escala" ni "sistemaDeReferencia"

        ItemDocumental mapa2 = new ItemDocumental("Plano rural 1930", 1930, 1);
        mapa2.escala = "25000";
        fondoCartografico.registrar(mapa2);
        mapa2.setMetadato("titulo", "Plano rural 1930");
        mapa2.setMetadato("escala", "25000");
        mapa2.setMetadato("sistemaDeReferencia", "MAGNA-SIRGAS");
        mapa2.setMetadato("fecha", "1930");
        mapa2.setMetadato("cobertura", "Zona rural");

        FondoFotografico fondoFotografico = new FondoFotografico();
        FabricaSoporte fabricaPlacaVidrio = new FabricaPlacaVidrio();

        ItemDocumental foto1 = new ItemDocumental("Plaza principal", 1927, 1);
        foto1.autor = null; // autor desconocido -> XXX en la signatura
        fondoFotografico.registrar(foto1);
        foto1.setMetadato("titulo", "Plaza principal");
        foto1.setMetadato("fecha", "1927");
        // a proposito faltan autor, tecnica y dimensiones

        System.out.println("  NOTARIAL      -> " + itemsNotarial.get(itemsNotarial.size() - 1).signatura);
        System.out.println("  CARTOGRAFICO  -> " + mapa2.signatura);
        System.out.println("  FOTOGRAFICO   -> " + foto1.signatura);

        // ---------- 3. Lotes y plan de recursos (Abstract Factory) ----------
        System.out.println("\nPLAN DE RECURSOS POR LOTE");

        List<Lote> lotes = new ArrayList<>();
        lotes.add(new Lote("Protocolos 1880-1890", new FabricaPapelFragil(), 24000, 4, 520, 1880));
        lotes.add(new Lote("Prensa regional 1955-1970", new FabricaMicrofilm(), 86000, 2, 310, 1955));
        lotes.add(new Lote("Placas Quintero", new FabricaPlacaVidrio(), 1800, 5, 140, 1925));
        lotes.add(new Lote("Negativos estudio Delgado", new FabricaPlacaVidrio(), 950, 3, 90, 1940));

