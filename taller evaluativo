        System.out.printf("%-3s%-28s%-6s%-10s%-10s%-10s%-8s%-6s%n",
            "#", "LOTE", "DET", "CONS/ANO", "INDICE", "JORNADAS", "INICIO", "FIN");
        int pos = 1;
        for (Lote l : priorizados) {
            System.out.printf("%-3d%-28s%-6d%-10d%-10.3f%-10d%-8d%-6d%n",
                pos++, l.nombre, l.deterioro, l.consultasAnuales, l.indicePrioridad,
                l.jornadas, l.jornadaInicio, l.jornadaFin);
        }

        // ---------- 5. Metadatos incompletos ----------
        System.out.println("\nMETADATOS INCOMPLETOS");
        ValidadorMetadatos validador = new ValidadorMetadatos();

        List<String> faltantesMapa1 = validador.validar(mapa1, fabricaMicrofilm);
        if (!faltantesMapa1.isEmpty()) {
            System.out.println("  " + mapa1.signatura + " -> faltan: " + String.join(", ", faltantesMapa1));
        }
