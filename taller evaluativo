        double volumenTotalGB = 0;

        System.out.printf("%-28s%-14s%-8s%-8s%-14s%-10s%n",
            "LOTE", "SOPORTE", "IMGS", "COPIAS", "VOLUMEN", "JORNADAS");
        for (Lote l : lotes) {
            planificador.calcularVolumenYTiempo(l);
            volumenTotalGB += l.volumenGB;
            int copias = l.fabrica.crearPoliticaAlmacenamiento().getNumeroCopias();
            System.out.printf("%-28s%-14s%-8d%-8d%-14s%-10d%n",
                l.nombre, l.fabrica.getNombreSoporte(), l.imagenes, copias,
