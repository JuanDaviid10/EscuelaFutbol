class Lote {
    String nombre;
    FabricaSoporte fabrica;
    int imagenes;
    int deterioro;          // 1 a 5
    int consultasAnuales;
    int anioMasAntiguo;

    double volumenGB;
    int jornadas;
    double indicePrioridad;
    int jornadaInicio;
    int jornadaFin;

    public Lote(String nombre, FabricaSoporte fabrica, int imagenes, int deterioro,
                int consultasAnuales, int anioMasAntiguo) {
        this.nombre = nombre;
        this.fabrica = fabrica;
        this.imagenes = imagenes;
        this.deterioro = deterioro;
        this.consultasAnuales = consultasAnuales;
        this.anioMasAntiguo = anioMasAntiguo;
    }
}

class ValidadorMetadatos {
    public List<String> validar(ItemDocumental item, FabricaSoporte fabrica) {
        List<String> faltantes = new ArrayList<>();
        for (String campo : fabrica.crearEsquemaMetadatos().getCamposObligatorios()) {
            String valor = item.metadatos.get(campo);
            if (valor == null || valor.isBlank()) {
                faltantes.add(campo);
            }
        }
        return faltantes;
    }
}

class Planificador {
    static final double HORAS_JORNADA = 6.5;
    static final int ESTACIONES = 2;

    // 5.1 volumen + 5.2 tiempo
    public void calcularVolumenYTiempo(Lote lote) {
        int copias = lote.fabrica.crearPoliticaAlmacenamiento().getNumeroCopias();
        double mbTotal = lote.imagenes * lote.fabrica.getMbPorImagen() * copias;
        lote.volumenGB = round(mbTotal / 1024.0, 2);

        double horas = lote.imagenes / lote.fabrica.getTasaCaptura();
        double horasEfectivas = horas / ESTACIONES;
        lote.jornadas = (int) Math.ceil(horasEfectivas / HORAS_JORNADA);
    }

    // 5.3 priorizacion
    public void calcularPrioridad(List<Lote> lotes, int anioActual) {
        int maxConsultas = lotes.stream().mapToInt(l -> l.consultasAnuales).max().orElse(1);
        int maxAntiguedad = lotes.stream()
            .mapToInt(l -> anioActual - l.anioMasAntiguo).max().orElse(1);

        for (Lote l : lotes) {
            int antiguedad = anioActual - l.anioMasAntiguo;
            double indice = 0.55 * (l.deterioro / 5.0)
                          + 0.30 * ((double) l.consultasAnuales / maxConsultas)
                          + 0.15 * ((double) antiguedad / maxAntiguedad);
            l.indicePrioridad = round(indice, 3);
        }
    }

    public List<Lote> priorizar(List<Lote> lotes) {
        List<Lote> ordenado = new ArrayList<>(lotes);
        ordenado.sort((a, b) -> {
            int cmp = Double.compare(b.indicePrioridad, a.indicePrioridad);
            if (cmp != 0) return cmp;
            return Integer.compare(b.deterioro, a.deterioro); // empate -> mayor deterioro primero
        });
        return ordenado;
    }

    // 5.4 cronograma
    public void generarCronograma(List<Lote> lotesPriorizados) {
        int jornadaActual = 1;
        for (Lote l : lotesPriorizados) {
            l.jornadaInicio = jornadaActual;
            l.jornadaFin = jornadaActual + l.jornadas - 1;
            jornadaActual = l.jornadaFin + 1;
        }
    }

    static double round(double valor, int decimales) {
        double factor = Math.pow(10, decimales);
        return Math.round(valor * factor) / factor;
    }
}

