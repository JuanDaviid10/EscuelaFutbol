    PerfilCaptura crearPerfilCaptura();
    EsquemaMetadatos crearEsquemaMetadatos();
    PoliticaAlmacenamiento crearPoliticaAlmacenamiento();
    double getMbPorImagen();
    double getTasaCaptura();
    String getNombreSoporte();
}

