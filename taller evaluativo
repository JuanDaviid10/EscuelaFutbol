// ============================================================
// FACTORY METHOD - generacion de la signatura por fondo (4.2)
// ============================================================

class Signatura {
    private String valor;
    public Signatura(String valor) { this.valor = valor; }
    public String toString() { return valor; }
}

class ItemDocumental {
    String titulo;
    int anio;
    int folios;
    Integer notaria;   // solo fondo NOTARIAL
    String escala;     // solo fondo CARTOGRAFICO
    String autor;      // solo fondo FOTOGRAFICO
    Map<String, String> metadatos = new LinkedHashMap<>();
    Signatura signatura;

    public ItemDocumental(String titulo, int anio, int folios) {
        this.titulo = titulo;
        this.anio = anio;
        this.folios = folios;
    }

    public void setMetadato(String campo, String valor) { metadatos.put(campo, valor); }
    public void setSignatura(Signatura s) { this.signatura = s; }
}

abstract class FondoDocumental {
    protected int consecutivo = 0;
    private String nombreFondo;

    public FondoDocumental(String nombreFondo) { this.nombreFondo = nombreFondo; }

    // Metodo publico: lleva el consecutivo, valida y devuelve el item signado
    public ItemDocumental registrar(ItemDocumental item) {
        if (item.titulo == null || item.titulo.isBlank()) {
            throw new IllegalArgumentException("El item debe tener titulo");
        }
        if (item.folios <= 0) {
            throw new IllegalArgumentException("El item debe tener folios > 0");
        }
        consecutivo++;
        Signatura signatura = crearSignatura(item);
        item.setSignatura(signatura);
        return item;
    }

    // Metodo fabrica: cada fondo decide su propio patron de signatura
    protected abstract Signatura crearSignatura(ItemDocumental item);

    public String getNombreFondo() { return nombreFondo; }
}

class FondoNotarial extends FondoDocumental {
    public FondoNotarial() { super("NOTARIAL"); }
    protected Signatura crearSignatura(ItemDocumental item) {
        String valor = String.format("NOT-%d-N%02d-%05d", item.anio, item.notaria, consecutivo);
        return new Signatura(valor);
    }
}

class FondoCartografico extends FondoDocumental {
    public FondoCartografico() { super("CARTOGRAFICO"); }
    protected Signatura crearSignatura(ItemDocumental item) {
        String valor = String.format("CAR-%s-%04d", item.escala, consecutivo);
        return new Signatura(valor);
    }
}

class FondoFotografico extends FondoDocumental {
    public FondoFotografico() { super("FOTOGRAFICO"); }
    protected Signatura crearSignatura(ItemDocumental item) {
        int decada = (item.anio / 10) * 10;
        String iniciales = calcularIniciales(item.autor);
        String valor = String.format("FOT-%ds-%s-%04d", decada, iniciales, consecutivo);
        return new Signatura(valor);
    }
    private String calcularIniciales(String autor) {
        if (autor == null || autor.trim().isEmpty()) return "XXX";
        String[] partes = autor.trim().split("\\s+");
        StringBuilder sb = new StringBuilder();
        for (String p : partes) sb.append(Character.toUpperCase(p.charAt(0)));
        return sb.toString();
    }
}

// ============================================================
// PROTOTYPE - fichas catalograficas de serie (4.3)
// ============================================================

class ProductorDocumental {
    String nombre;
    List<String> cargos;

    public ProductorDocumental(String nombre, List<String> cargos) {
        this.nombre = nombre;
        this.cargos = new ArrayList<>(cargos);
    }

    // clonacion propia (no compartir la lista de cargos)
    public ProductorDocumental copiaProfunda() {
        return new ProductorDocumental(this.nombre, new ArrayList<>(this.cargos));
    }
}

class FichaCatalografica {
    String fondo;
    ProductorDocumental productor;
    String alcance;
    String condicionesAcceso;
    String idioma;
    List<String> descriptores;

    // lo unico que cambia por item
    String titulo;
    String fechaExtrema;
    int folios;

    public FichaCatalografica(String fondo, ProductorDocumental productor, String alcance,
                               String condicionesAcceso, String idioma, List<String> descriptores) {
        this.fondo = fondo;
        this.productor = productor;
        this.alcance = alcance;
        this.condicionesAcceso = condicionesAcceso;
        this.idioma = idioma;
        this.descriptores = new ArrayList<>(descriptores);
    }

    // Prototype: clonacion en profundidad
    public FichaCatalografica clonar() {
        FichaCatalografica copia = new FichaCatalografica(
            this.fondo,
            this.productor.copiaProfunda(),   // productor independiente
            this.alcance,
            this.condicionesAcceso,
            this.idioma,
            this.descriptores                  // el constructor ya copia la lista
        );
        copia.titulo = this.titulo;
        copia.fechaExtrema = this.fechaExtrema;
        copia.folios = this.folios;
        return copia;
    }

    public void agregarDescriptor(String descriptor) { this.descriptores.add(descriptor); }
    public void agregarCargoProductor(String cargo) { this.productor.cargos.add(cargo); }
}

